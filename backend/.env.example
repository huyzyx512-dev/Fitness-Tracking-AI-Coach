# Copy to .env and fill in real values locally. Never commit .env.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

PORT=5000
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=

MYSQL_DATABASE=fitness_tracker
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fitness-app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Generate a long random string for production (e.g. openssl rand -hex 64)
ACCESS_TOKEN_SECRET=

# ─── Sepay payment provider ──────────────────────────────────────────────
SEPAY_PROVIDER_ENABLED=0
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_TEMPLATE=
SEPAY_ORDER_TTL_MINUTES=30
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=

# ─── AI (OpenRouter — official provider) ───
# Local sample: feature off, không có key thật. Operator production/staging BẮT BUỘC set AI_FEATURE_ENABLED=1
# và chọn model cụ thể (không rely openrouter/free cho volume cao).
# Không polling OpenRouter /models. Không retry 429 tự động. Không đưa biến AI provider vào frontend env.

# Local dev (default an toàn — boot OK, không gọi OpenRouter khi disabled):
AI_FEATURE_ENABLED=0
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openrouter/free
AI_REQUEST_TIMEOUT_MS=60000

# OpenRouter attribution (optional nhưng khuyến nghị staging/production):
# OPENROUTER_HTTP_REFERER = frontend origin thật — không hardcode domain production trong source.
# OPENROUTER_APP_TITLE = tên app hiển thị trên OpenRouter dashboard.
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=FitTrack AI Coach

# ─── Production / staging deploy (set trên server process — không commit .env) ───
# Operator bật AI khi deploy:
#   AI_FEATURE_ENABLED=1
#   AI_PROVIDER=openrouter
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=<set-in-server-env>   # chỉ server/process env; KHÔNG commit; KHÔNG đưa vào frontend env
#   AI_MODEL=<model-cụ-thể>          # openrouter/free chỉ dev/demo/low-volume; production chọn model ổn định lúc deploy
#   AI_REQUEST_TIMEOUT_MS=60000      # quá thấp → false timeout; quá cao → giữ connection trên máy yếu
#   OPENROUTER_HTTP_REFERER=<frontend-origin-thật>
#   OPENROUTER_APP_TITLE=FitTrack AI Coach
# Sau khi set: restart process/container; verify printenv | grep -E 'AI_|OPENROUTER_' (mask key).

# ─── Legacy Stage 1 workaround (do not use for new setups) ───
# Before Stage 2, OpenRouter was reached via AI_PROVIDER=openai + OpenRouter base URL.
# From Stage 2 onward, use AI_PROVIDER=openrouter (values above).
# Old workaround example (deprecated):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openrouter/free
#   AI_API_KEY=<OpenRouter key from https://openrouter.ai/keys — never commit>
